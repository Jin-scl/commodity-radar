# 复制到 .env 并填入实际值；.env 不要 commit
# v1 中所有预警通道默认 dry-run，配置后自动切换为真实发送

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# 飞书 Webhook（机器人 webhook 链接）
FEISHU_WEBHOOK_URL=

# 全局开关
ALERTS_DRY_RUN=true
LOG_LEVEL=INFO
